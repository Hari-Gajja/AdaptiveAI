# --- OpenCode Go ---
# Get your key from https://opencode.ai/auth (subscribe to Go, copy API key)
OPENCODE_API_KEY=
# Default endpoint for OpenAI-compatible models (chat/completions family).
# Do NOT change unless you know what you are doing. Per-model endpoints are
# resolved automatically in backend/providers/opencode.py.
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# Two-model MVP: pick TWO models that share the SAME endpoint family to keep
# Phase 1 to a single protocol. Recommended (same chat/completions endpoint):
#   MODEL_A_ID=deepseek-v4-flash   (cheap,  $0.22 in / $0.66 out per 1M)
#   MODEL_B_ID=deepseek-v4-pro     (strong, $0.66 in / $1.98 out per 1M)
# Alternative cheapest demo pair (same endpoint):
#   MODEL_A_ID=mimo-v2.5           ($0.14 / $0.28)
#   MODEL_B_ID=glm-5.2             ($1.40 / $4.40)
# Avoid mixing families in Phase 1 (e.g. deepseek + muse-spark) because
# muse-spark uses /v1/responses (different request/response shape).
MODEL_A_ID=deepseek-v4-flash
MODEL_B_ID=deepseek-v4-pro
# Optional: helps OpenCode optimize prompt caching + avoids abuse flags
OPENCODE_SESSION_ID=llm-cost-optimizer-phase1
# --- Persistence + quality threshold ---
# Local MongoDB or free Atlas cluster (mongodb+srv://...). If unreachable,
# the app transparently uses an in-memory store and reports it in /api/analytics.
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=llm_optimizer
QUALITY_THRESHOLD=0.75
# --- Cache backend (Phase 7) ---
# Real Redis when reachable; transparent in-memory fallback (same API) otherwise.
#   docker run -d -p 6379:6379 --name llmo-redis redis:7-alpine
REDIS_URL=redis://localhost:6379/0
# Semantic tier: cosine similarity >= threshold is a candidate; safety gates
# then decide. Set 0 to disable the semantic tier.
SEMANTIC_THRESHOLD=0.92
SEMANTIC_MAX_ENTRIES=256

# --- Control plane (Phase 8) ---
# The control plane reuses the SAME OpenCode provider (backend/providers/opencode.py)
# with a small, cheap model for three jobs:
#   1. classifier  — task type / difficulty / confidence per prompt
#   2. cache_verifier — veto-only double-check of semantic-cache reuse
#   3. evaluator   — LLM-as-judge for subjective tasks (no reference, non-math)
# Every control-plane token is tracked in a per-request ledger:
#   Total Cost = Control Plane + Task Model
# Disable to run the legacy heuristic classifier with zero CP spend.
OPENCODE_ENABLED=true
# Control-plane model (must be priced in the registry; cheap + fast).
OPENCODE_MODEL=deepseek-v4-flash
# Hard timeout for each control-plane call (seconds). On timeout/error the
# system falls back to deterministic logic and marks the ledger "degraded".
OPENCODE_TIMEOUT_SECONDS=20.0
# Which classifier backend to use: "opencode" | "legacy_ml"
CLASSIFIER_BACKEND=opencode
# Quality-check mode: "off" | "benchmark" | "live"
#   off       — deterministic reference scoring only (no LLM judge)
#   benchmark — reference scoring when a reference exists; no LLM judge
#   live      — subjective tasks without reference get the LLM evaluator
QUALITY_CHECK_MODE=live
# Veto-only LLM double-check of semantic-cache reuse (runs ONLY after all
# deterministic safety gates pass; it can never approve a blocked reuse).
CACHE_VERIFY_ENABLED=true

# --- Control-plane token budgets (prompt truncation + max output) ---
# Prompts sent to the control plane are clipped to this many chars.
CONTROL_PLANE_PROMPT_MAX_CHARS=1200
CLASSIFIER_MAX_OUTPUT_TOKENS=50
VERIFIER_MAX_OUTPUT_TOKENS=40
EVALUATOR_MAX_OUTPUT_TOKENS=80
# Minimum classifier confidence below which the router flags low confidence.
CLASSIFIER_CONFIDENCE_THRESHOLD=0.70
# When true, a control-plane failure raises instead of falling back (debug).
CONTROL_PLANE_STRICT=false

# --- Token optimization (spec §3/§19/§21) ---
# Task-aware minimal system prompts (prompt_builder): adds a short system
# clause for math/coding/debugging tasks; plain questions pass through raw.
# Disable to send raw turns only.
PROMPT_TEMPLATES_ENABLED=true
# Naive baseline output budget for token-savings math (spec §21): the
# counterfactual "unoptimized" request is assumed to request this many output
# tokens. Optimized requests use the predicted small/medium/large budget.
TOKEN_OPT_BASELINE_OUTPUT_BUDGET=1024
